# УЧЕБНЫЙ ПРИМЕР ПЛОХОГО DOCKERFILE - не используйте в реальных проектах

# Проблема 1: Python 3.7 не поддерживается с июня 2023 года,
# исправления безопасности для него больше не выходят
FROM python:3.7-slim

WORKDIR /app

# Проблема 2: устаревшие зависимости с известными CVE
COPY requirements-insecure.txt requirements.txt
RUN pip install -r requirements.txt

# Проблема 3: копируется весь контекст сборки целиком
COPY . .

# Проблема 4: процесс работает от root,
# а встроенный dev-сервер Flask не предназначен для продакшена
EXPOSE 5000
CMD ["python", "app.py"]
